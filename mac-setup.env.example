# ansible-pull 実行時に環境変数として読み込まれる機密値。
# ~/.local/etc/mac-setup.env に配置し、必ず chmod 0600 にすること。
#
# このファイルは ansible-pull のラッパー (~/.local/bin/mac-setup-pull.sh) で
# `set -a; source ...; set +a` により export される。
# Ansible playbook の `environment:` ディレクティブを介さないため、
# ps/argv へのトークン露出を防げる。
#
# 手動で ansible-pull を直接実行する場合は事前に source すること:
#   set -a; source ~/.local/etc/mac-setup.env; set +a
#   ansible-pull ...

# GitHub Personal Access Token
# - mise が GitHub Releases から大量にツールを取得するため API rate limit 緩和に必須
# - Homebrew API rate limit 緩和 (HOMEBREW_GITHUB_API_TOKEN) にも流用
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HOMEBREW_GITHUB_API_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
