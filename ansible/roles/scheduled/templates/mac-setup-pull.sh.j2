#!/bin/zsh
set -euo pipefail
# {{ ansible_managed }}
# ansible-pull のラッパー。GITHUB_TOKEN 等の機密を ps/argv に露出させずに渡すため、
# 環境変数ファイルを source してから ansible-pull を exec する。

ENV_FILE="${HOME}/.local/etc/mac-setup.env"
EXTRA_VARS_FILE="${HOME}/.local/etc/extra_vars.yaml"

if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
fi

ARGS=(
  --url "{{ scheduled.repo_url }}"
  --checkout "{{ scheduled.branch }}"
  --inventory ansible/inventories/hosts.yaml
)

if [[ -f "${EXTRA_VARS_FILE}" ]]; then
  ARGS+=(--extra-vars "@${EXTRA_VARS_FILE}")
fi

ARGS+=(ansible/playbook.yaml)

exec /opt/homebrew/bin/ansible-pull "${ARGS[@]}"
