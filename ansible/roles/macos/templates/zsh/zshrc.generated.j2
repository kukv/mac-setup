# {{ ansible_managed }}

export PATH="$HOME/.local/bin:$PATH"

# ========================================================
# = oh-my-zsh
# ========================================================

export ZSH="${HOME}/.oh-my-zsh"

ZSH_THEME="{{ zsh.theme }}"

# ==========================================================================
# = Oh-My-Zsh theme(alien) configuration
# ==========================================================================

export ALIEN_SECTIONS_LEFT=(
{% for section in zsh.alien.sections_left %}
    {{ section }}
{% endfor %}
)

export ALIEN_SECTION_TIME_FORMAT="{{ zsh.alien.time_format }}"
export ALIEN_SECTION_USER_HOST={{ zsh.alien.user_host }}

export ALIEN_THEME="{{ zsh.alien.theme }}"
export ALIEN_USE_NERD_FONT=1

plugins=(
{{ zsh.plugins | map('regex_replace', '^', '  ') | join('\n') }}
)

source "${ZSH}/oh-my-zsh.sh"

# ========================================================
# = 1Password
# ========================================================

export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

# ========================================================
# = Docker
# ========================================================

fpath=(${HOME}/.docker/completions $fpath)
autoload -Uz compinit
compinit

# ========================================================
# = zsh options
# ========================================================

setopt extended_history

# ========================================================
# = mise
# ========================================================

eval "$(mise activate zsh)"

# ========================================================
# = peco
# ========================================================

function peco-select-history() {
  local tac
  if which tac > /dev/null; then
    tac="tac"
  else
    tac="tail -r"
  fi
  BUFFER=$(\history -n 1 | \
    eval $tac | \
    peco --query "$LBUFFER")
  CURSOR=$#BUFFER
  zle clear-screen
}
zle -N peco-select-history
bindkey '^r' peco-select-history

function peco-src () {
  local selected_dir=$(ghq list -p | peco --prompt="repositories >" --query "$LBUFFER")
  if [ -n "$selected_dir" ]; then
    BUFFER="cd ${selected_dir}"
    zle accept-line
  fi
  zle clear-screen
}
zle -N peco-src
bindkey '^]' peco-src
